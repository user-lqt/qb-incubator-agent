# 密钥与本地配置：绝不外传
.env

# Python 缓存
__pycache__/
*.py[cod]

# 虚拟环境
.venv/
venv/

# 打包产物
build/
dist/
*.spec

# 临时文件：提交信息、抓取缓存等，一律不入库
_msg*.txt
_m*.txt
_raw_*.md
_repo.html

# 背景图的本地工作文件：无损母版与旧图备份留在本地，
# 仓库只保留 pics/bg-src.jpg（tools/make_background.py 的默认生成源）
pics/bg-src-master.png
pics/bg-src-*-original.jpg
