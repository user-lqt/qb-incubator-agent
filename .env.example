# 复制这个文件为 .env，然后填入自己的 key（不要提交到 Git、不要发给别人）

# DeepSeek API key，去 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-你的key

# API 地址与模型（一般不用改）
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# ---- 网页版（serve.py）可选设置 ----
# 访问口令：设置后同学必须输入口令才能用，防止陌生人白嫖额度
ACCESS_PASSWORD=
# 每日总提问上限，0 表示不限
DAILY_LIMIT=200
# 端口
PORT=8080
